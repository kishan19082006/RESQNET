<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RESQNET OFFLINE SOS"
            android:textColor="#F87171"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatusBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="#1E293B"
            android:padding="12dp"
            android:text="Ready - Offline Queue Active"
            android:textColor="#4ADE80"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinnerEmergencyType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etVictimName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Victim Name"
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phone Number"
            android:inputType="phone"
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etPeopleCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="People (1)"
                android:inputType="number"
                android:textColor="#FFFFFF" />

            <EditText
                android:id="@+id/etChildrenCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Children (0)"
                android:inputType="number"
                android:textColor="#FFFFFF" />

            <EditText
                android:id="@+id/etInjuredCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Injured (0)"
                android:inputType="number"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvGpsCoords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="GPS: 13.1845, 74.9360"
            android:textColor="#CBD5E1" />

        <Button
            android:id="@+id/btnFetchGps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lock Offline Satellite GPS" />

        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Landmark / Floor / Situation Details"
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8" />

        <Button
            android:id="@+id/btnSendSos"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#EF4444"
            android:text="SEND EMERGENCY SOS"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
